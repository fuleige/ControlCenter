# 首次执行 controller-center-agent-enroll 后，地址与独立凭证会写入 AGENT_DATA_DIR/connection.json。
# 下面两项只用于旧共享 Token 节点迁移或显式覆盖。
# CONTROL_CENTER_URL=wss://control.example.com/agent/connect
# AGENT_TOKEN=replace-with-the-same-value-as-AGENT_SHARED_TOKEN
AGENT_NAME=build-node-01
AGENT_DATA_DIR=/var/lib/controller-center-agent
CODEX_BIN=/usr/local/bin/codex
MAX_CONCURRENT_RUNS=5
AGENT_NETWORK_ACCESS=false
# systemd 服务不会自动继承交互式 shell 的环境；需要代理时在这里显式配置。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
# 全权限不是环境变量；需要时在 Agent 启动命令末尾显式添加 --yolo。
# 仅 Codex 使用代理也不是环境变量；需要时在启动和注册命令末尾添加 --codex-proxy-only。
# 可选附加项；默认工作空间始终由 systemd WorkingDirectory 决定。
AGENT_WORKSPACES='[{"id":"project-a","name":"Project A","path":"/srv/project-a"}]'
